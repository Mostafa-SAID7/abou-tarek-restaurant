{
  "name": "restaurant-project",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "eslint --ext .js,.vue src",
    "format": "prettier --write \"src/**/*.{js,vue,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,json,css}\"",
    "test:unit": "jest --runInBand",
    "test:e2e": "playwright test",
    "test": "npm run lint && npm run test:unit && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,vue}": "eslint --fix",
    "src/**/*.{js,vue,json,css}": "prettier --write"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "pinia": "^4.0.3",
    "vue": "^3.4.31",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@playwright/test": "^1.62.1",
    "@vue/cli-plugin-babel": "^5.0.8",
    "@vue/cli-plugin-eslint": "^5.0.8",
    "@vue/cli-service": "^5.0.8",
    "autoprefixer": "^10.4.18",
    "babel-jest": "^30.4.1",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.3.3"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true,
      "es2021": true
    },
    "extends": [
      "plugin:vue/vue3-recommended",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false,
      "ecmaVersion": 2020
    },
    "rules": {
      "vue/multi-word-component-names": "off",
      "no-console": "warn",
      "no-debugger": "warn"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
